# Required. Any long random string; sessions, delegations and receipts are signed with it.
AUTH_SECRET=replace-me-with-a-long-random-string

# Optional. Without these the storefront uses the built-in credits paywall, which
# needs no wallet and is what the demo runs on by default.
X402_PAY_TO=0xYourMerchantAddress
X402_ASSET=0xUSDCContractAddress
X402_NETWORK=base
X402_FACILITATOR_URL=https://x402.org/facilitator
